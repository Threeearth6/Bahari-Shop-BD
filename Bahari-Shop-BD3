            outsideFee: 170,
            heroTitle: 'সেরা কালেকশন এখন আপনার হাতের নাগালে!',
            notice: '👉 বাহারী শপ বিডিতে স্বাগতম 🌸 | ❌ অগ্রিম টাকা লাগে না | 📦 পণ্য হাতে পেয়ে দেখে টাকা দিন | 🎯 ১০০% কোয়ালিটি পণ্য | 🚚 হোম ডেলিভারি সারা বাংলাদেশে | 📞 হটলাইন: ০১৭০৬৫৫৫৩৭৩',
            logoData: '',
            bannerData: ''
        };

        const DEFAULT_PRODS = [
            {
                id: 101,
                name: 'আনরেডি প্রিমিয়াম কটন থ্রি পিস',
                category: 'থ্রি-পিস ও পোশাক',
                price: 1220,
                oldPrice: 1450,
                img: 'https://images.unsplash.com/photo-1610030469983-98e550d6193c?w=500',
                desc: '১০০% পিওর কটন ফ্যাব্রিক।\n• কামিজ: আনরেডি পর্যাপ্ত বহর\n• ওড়না: আরামদায়ক ম্যাচিং ওড়না\n• সালোয়ার: সফট কটন\n• রঙের স্থায়িত্ব ও আরামদায়ক বুনন।'
            },
            {
                id: 102,
                name: 'নমুনা পণ্য: প্রিমিয়াম বুটিক থ্রি-পিস',
                category: 'থ্রি-পিস ও পোশাক',
                price: 1490,
                oldPrice: 2200,
                img: 'https://images.unsplash.com/photo-1583391733956-3750e0ff4e8b?w=500',
                desc: 'এক্সক্লুসিভ বুটিক ডিজাইন।\n• উৎসব ও নিয়মিত ব্যবহারের উপযোগী\n• সারাদেশে ক্যাশ অন ডেলিভারি সুবিধা।'
            }
        ];

        let cfg = { ...DEFAULT_CFG, ...(JSON.parse(localStorage.getItem('bahari_v3_cfg')) || {}) };
        let prods = JSON.parse(localStorage.getItem('bahari_v3_prods')) || DEFAULT_PRODS;
        let cart = [];
        let activeCat = 'সব';
        let tempProductImg = '';
        let dmQty = 1;

        function compressImageToDataUrl(file, maxWidth, quality, cb) {
            const reader = new FileReader();
            reader.onload = function(e) {
                const img = new Image();
                img.onload = function() {
                    const canvas = document.createElement('canvas');
                    let w = img.width;
                    let h = img.height;
                    if (w > maxWidth) {
                        h = Math.round((h * maxWidth) / w);
                        w = maxWidth;
                    }
                    canvas.width = w;
                    canvas.height = h;
                    const ctx = canvas.getContext('2d');
                    ctx.drawImage(img, 0, 0, w, h);
                    cb(canvas.toDataURL('image/jpeg', quality));
                };
                img.src = e.target.result;
            };
            reader.readAsDataURL(file);
        }

        function handleImageUpload(event, target) {
            const file = event.target.files[0];
            if (!file) return;

            const maxW = target === 'banner' ? 900 : 500;
            compressImageToDataUrl(file, maxW, 0.72, function(dataUrl) {
                if (target === 'logo') {
                    cfg.logoData = dataUrl;
                    localStorage.setItem('bahari_v3_cfg', JSON.stringify(cfg));
                    applyConfig();
                    alert('নতুন লোগো সেট হয়েছে!');
                } else if (target === 'banner') {
                    cfg.bannerData = dataUrl;
                    localStorage.setItem('bahari_v3_cfg', JSON.stringify(cfg));
                    applyConfig();
                    alert('নতুন ব্যানার ছবি সেট হয়েছে!');
                } else if (target === 'product') {
                    tempProductImg = dataUrl;
                    const prev = document.getElementById('np-preview');
                    prev.src = dataUrl;
                    prev.classList.remove('hidden');
                }
            });
        }

        function applyConfig() {
            document.getElementById('site-name-display').innerText = cfg.shopName;
            document.getElementById('site-tagline-display').innerText = cfg.tagline;
            document.getElementById('footer-shop-name').innerText = cfg.shopName;
            document.getElementById('hero-title').innerText = cfg.heroTitle;

            document.getElementById('notice-text-1').innerText = cfg.notice;
            document.getElementById('notice-text-2').innerText = cfg.notice;

            document.getElementById('f-phone').innerText = cfg.phone;
            document.getElementById('f-whatsapp').innerText = cfg.whatsapp;
            document.getElementById('f-bkash').innerText = cfg.bkash;

            document.getElementById('fc-sylhet').innerText = cfg.sylhetFee;
            document.getElementById('fc-dhaka').innerText = cfg.dhakaFee;
            document.getElementById('fc-outside').innerText = cfg.outsideFee;

            document.getElementById('dz-sylhet').innerText = cfg.sylhetFee;
            document.getElementById('dz-dhaka').innerText = cfg.dhakaFee;
            document.getElementById('dz-outside').innerText = cfg.outsideFee;

            const cleanWa = String(cfg.whatsapp).replace(/\D/g, '') || '8801706555373';
            document.getElementById('hero-wa-btn').href = `https://wa.me/${cleanWa}`;

            const logoBox = document.getElementById('site-logo-box');
            if (cfg.logoData) {
                logoBox.innerHTML = `<img src="${cfg.logoData}" alt="Logo" class="w-full h-full object-cover">`;
            }

            const bannerImg = document.getElementById('hero-banner-img');
            const bannerPh = document.getElementById('hero-banner-placeholder');
            if (cfg.bannerData) {
                bannerImg.src = cfg.bannerData;
                bannerImg.classList.remove('hidden');
                bannerPh.classList.add('hidden');
            } else {
                bannerImg.classList.add('hidden');
                bannerPh.classList.remove('hidden');
            }

            // Fill admin fields
            document.getElementById('cfg-name').value = cfg.shopName;
            document.getElementById('cfg-phone').value = cfg.phone;
            document.getElementById('cfg-whatsapp').value = cfg.whatsapp;
            document.getElementById('cfg-bkash').value = cfg.bkash;
            document.getElementById('cfg-sylhet').value = cfg.sylhetFee;
            document.getElementById('cfg-dhaka').value = cfg.dhakaFee;
            document.getElementById('cfg-outside').value = cfg.outsideFee;
            document.getElementById('cfg-hero-title').value = cfg.heroTitle;
            document.getElementById('cfg-notice').value = cfg.notice;
        }

        function saveAllSettings() {
            cfg.shopName = document.getElementById('cfg-name').value.trim() || DEFAULT_CFG.shopName;
            cfg.phone = document.getElementById('cfg-phone').value.trim() || DEFAULT_CFG.phone;
            cfg.whatsapp = document.getElementById('cfg-whatsapp').value.trim() || DEFAULT_CFG.whatsapp;
            cfg.bkash = document.getElementById('cfg-bkash').value.trim() || DEFAULT_CFG.bkash;
            cfg.sylhetFee = Number(document.getElementById('cfg-sylhet').value) || 60;
            cfg.dhakaFee = Number(document.getElementById('cfg-dhaka').value) || 150;
            cfg.outsideFee = Number(document.getElementById('cfg-outside').value) || 170;
            cfg.heroTitle = document.getElementById('cfg-hero-title').value.trim() || DEFAULT_CFG.heroTitle;
            cfg.notice = document.getElementById('cfg-notice').value.trim() || DEFAULT_CFG.notice;

            localStorage.setItem('bahari_v3_cfg', JSON.stringify(cfg));
            applyConfig();
            calcTotals();
            alert('সব সেটিংস সফলভাবে সেভ হয়েছে!');
        }

        function openPinModal() { document.getElementById('pin-modal').classList.remove('hidden'); }
        function closePinModal() { document.getElementById('pin-modal').classList.add('hidden'); }
        function closeAdminPanel() {
            document.getElementById('admin-panel').classList.add('hidden');
            renderProducts();
        }

        function checkPin(e) {
            e.preventDefault();
            if (document.getElementById('pin-field').value === '1234') {
                document.getElementById('pin-field').value = '';
                closePinModal();
                applyConfig();
                renderAdminList();
                document.getElementById('admin-panel').classList.remove('hidden');
            } else {
                alert('ভুল পিন! সঠিক পিন 1234 দিন।');
            }
        }

        function saveNewProduct() {
            const name = document.getElementById('np-name').value.trim();
            const category = document.getElementById('np-cat').value;
            const price = Number(document.getElementById('np-price').value);
            const oldPrice = Number(document.getElementById('np-old-price').value) || 0;
            const urlInput = document.getElementById('np-img-url').value.trim();
            const desc = document.getElementById('np-desc').value.trim();

            if (!name || !price) {
                alert('পণ্যের নাম এবং মূল্য অবশ্যই লিখুন!');
                return;
            }

            const finalImg = tempProductImg || urlInput || 'https://images.unsplash.com/photo-1523381210434-271e8be1f52b?w=500';

            prods.unshift({
                id: Date.now(),
                name,
                category,
                price,
                oldPrice,
                img: finalImg,
                desc
            });

            localStorage.setItem('bahari_v3_prods', JSON.stringify(prods));

            document.getElementById('np-name').value = '';
            document.getElementById('np-price').value = '';
            document.getElementById('np-old-price').value = '';
            document.getElementById('np-img-url').value = '';
            document.getElementById('np-file').value = '';
            document.getElementById('np-desc').value = '';
            tempProductImg = '';
            document.getElementById('np-preview').classList.add('hidden');

            renderAdminList();
            alert('নতুন পণ্য সফলভাবে যুক্ত হয়েছে!');
        }

        function deleteProd(id) {
            prods = prods.filter(p => p.id !== id);
            localStorage.setItem('bahari_v3_prods', JSON.stringify(prods));
            renderAdminList();
        }

        function renderAdminList() {
            const box = document.getElementById('admin-prod-list');
            if (!prods.length) {
                box.innerHTML = '<p class="text-xs text-slate-400">কোনো পণ্য যুক্ত করা হয়নি।</p>';
                return;
            }
            box.innerHTML = prods.map(p => `
                <div class="flex items-center justify-between bg-white p-2.5 rounded-xl border text-xs gap-2">
                    <div class="flex items-center gap-2.5 min-w-0">
                        <img src="${p.img}" alt="" class="w-11 h-11 object-cover rounded-lg border shrink-0">
                        <div class="truncate">
                            <p class="font-bold truncate">${p.name}</p>
                            <p class="text-brandRed font-semibold">${p.price}৳ • ${p.category}</p>
                        </div>
                    </div>
                    <button type="button" onclick="deleteProd(${p.id})" class="bg-red-50 text-red-600 border border-red-200 px-3 py-1.5 rounded-lg font-bold shrink-0">ডিলিট</button>
                </div>
            `).join('');
        }

        function setCategory(cat) {
            activeCat = cat;
            document.getElementById('active-cat-title').innerText = cat === 'সব' ? 'সকল পণ্যসমূহ' : cat;
            document.querySelectorAll('.cat-btn').forEach(btn => {
                const isMatch = (cat === 'সব' && btn.innerText.includes('সব পণ্য')) || btn.innerText.trim() === cat;
                btn.className = isMatch
                    ? 'cat-btn px-3.5 py-1.5 rounded-full text-xs font-bold bg-brandEmerald text-white shrink-0'
                    : 'cat-btn px-3.5 py-1.5 rounded-full text-xs font-semibold bg-white text-slate-700 border shrink-0';
            });
            renderProducts();
        }

        function resetFilters() {
            document.getElementById('search-box').value = '';
            setCategory('সব');
        }

        function renderProducts() {
            const q = document.getElementById('search-box').value.trim().toLowerCase();
            const list = prods.filter(p => {
                const okCat = activeCat === 'সব' || p.category === activeCat;
                const okSearch = !q || p.name.toLowerCase().includes(q) || (p.desc && p.desc.toLowerCase().includes(q));
                return okCat && okSearch;
            });

            document.getElementById('product-total-count').innerText = list.length;
            const grid = document.getElementById('product-grid');

            if (!list.length) {
                grid.innerHTML = '<div class="col-span-full bg-white p-10 rounded-2xl border text-center text-xs text-slate-500">কোনো পণ্য পাওয়া যায়নি।</div>';
                return;
            }

            grid.innerHTML = list.map(p => {
                let badge = '';
                if (p.oldPrice && p.oldPrice > p.price) {
                    const pct = Math.round(((p.oldPrice - p.price) / p.oldPrice) * 100);
                    badge = `<span class="absolute top-2 left-2 bg-brandRed text-white text-[10px] font-bold px-2 py-0.5 rounded-md shadow">-${pct}% ছাড়</span>`;
                }
                return `
                    <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm flex flex-col justify-between">
                        <div>
                            <div onclick="openDetail(${p.id})" class="relative aspect-square bg-slate-100 overflow-hidden cursor-pointer">
                                <img src="${p.img}" alt="${p.name}" class="w-full h-full object-cover hover:scale-105 transition duration-300">
                                ${badge}
                            </div>
                            <div class="p-3 space-y-1">
                                <span class="text-[10px] font-semibold text-brandTeal bg-emerald-50 px-2 py-0.5 rounded">${p.category}</span>
                                <h4 onclick="openDetail(${p.id})" class="font-bold text-xs sm:text-sm text-slate-800 line-clamp-2 cursor-pointer">${p.name}</h4>
                                <p class="text-[11px] text-slate-500 line-clamp-2">${p.desc || ''}</p>
                                <div class="flex items-baseline gap-2 pt-1">
                                    <span class="text-sm sm:text-base font-bold text-brandRed">${p.price}৳</span>
                                    ${p.oldPrice ? `<span class="text-[11px] text-slate-400 line-through">${p.oldPrice}৳</span>` : ''}
                                </div>
                            </div>
                        </div>
                        <div class="px-3 pb-3 grid grid-cols-2 gap-1.5">
                            <button type="button" onclick="addToCart(${p.id}, 1)" class="bg-orange-50 hover:bg-orange-100 text-brandRed border border-orange-200 font-bold py-1.5 rounded-xl text-[11px]">কার্ট</button>
                            <button type="button" onclick="addToCart(${p.id}, 1); openCartDrawer();" class="bg-gradient-to-r from-brandOrange to-brandRed text-white font-bold py-1.5 rounded-xl text-[11px] shadow">অর্ডার করুন</button>
                        </div>
                    </div>
                `;
            }).join('');
        }

        function openDetail(id) {
            const p = prods.find(item => item.id === id);
            if (!p) return;
            dmQty = 1;
            document.getElementById('dm-cat').innerText = p.category;
            document.getElementById('dm-img').src = p.img;
            document.getElementById('dm-name').innerText = p.name;
            document.getElementById('dm-price').innerText = `${p.price}৳`;
            document.getElementById('dm-old-price').innerText = p.oldPrice ? `${p.oldPrice}৳` : '';
            document.getElementById('dm-desc').innerText = p.desc || 'বিস্তারিত বিবরণ নেই।';
            document.getElementById('dm-qty').innerText = dmQty;

            const b = document.getElementById('dm-badge');
            if (p.oldPrice && p.oldPrice > p.price) {
                b.innerText = `-${Math.round(((p.oldPrice - p.price) / p.oldPrice) * 100)}% ছাড়`;
                b.classList.remove('hidden');
            } else {
                b.classList.add('hidden');
            }

            document.getElementById('dm-add-cart').onclick = () => { addToCart(p.id, dmQty); closeDetailModal(); };
            document.getElementById('dm-buy-now').onclick = () => { addToCart(p.id, dmQty); closeDetailModal(); openCartDrawer(); };
            document.getElementById('detail-modal').classList.remove('hidden');
        }

        function closeDetailModal() { document.getElementById('detail-modal').classList.add('hidden'); }
        function changeDmQty(d) {
            dmQty = Math.max(1, dmQty + d);
            document.getElementById('dm-qty').innerText = dmQty;
        }

        function addToCart(id, qty) {
            const p = prods.find(item => item.id === id);
            if (!p) return;
            const found = cart.find(item => item.id === id);
            if (found) found.qty += qty;
            else cart.push({ ...p, qty });
            updateCartBadge();
        }

        function updateCartBadge() {
            const count = cart.reduce((s, i) => s + i.qty, 0);
            document.getElementById('cart-count').innerText = count;
        }

        function openCartDrawer() {
            renderCartList();
            document.getElementById('cart-drawer').classList.remove('hidden');
        }

        function closeCartDrawer() { document.getElementById('cart-drawer').classList.add('hidden'); }

        function renderCartList() {
            const box = document.getElementById('cart-list');
            if (!cart.length) {
                box.innerHTML = '<p class="text-xs text-slate-400 text-center py-4">আপনার কার্ট খালি রয়েছে।</p>';
                calcTotals();
                return;
            }
            box.innerHTML = cart.map(item => `
                <div class="flex items-center justify-between bg-slate-50 p-2.5 rounded-xl border text-xs">
                    <div class="flex items-center gap-2 min-w-0">
                        <img src="${item.img}" alt="" class="w-10 h-10 object-cover rounded-lg shrink-0">
                        <div class="truncate">
                            <p class="font-bold truncate">${item.name}</p>
                            <p class="text-brandRed font-semibold">${item.price}৳ × ${item.qty}</p>
                        </div>
                    </div>
                    <button type="button" onclick="removeCartItem(${item.id})" class="text-red-500 font-bold px-2">✕</button>
                </div>
            `).join('');
            calcTotals();
        }

        function removeCartItem(id) {
            cart = cart.filter(i => i.id !== id);
            updateCartBadge();
            renderCartList();
        }

        function getDeliveryFeeAndLabel() {
            const zone = document.querySelector('input[name="dZone"]:checked').value;
            if (zone === 'dhaka') return { fee: Number(cfg.dhakaFee) || 150, label: 'ঢাকার ভেতরে' };
            if (zone === 'outside') return { fee: Number(cfg.outsideFee) || 170, label: 'সারাদেশে' };
            return { fee: Number(cfg.sylhetFee) || 60, label: 'সিলেটের ভেতরে' };
        }

        function calcTotals() {
            const subtotal = cart.reduce((s, i) => s + (i.price * i.qty), 0);
            const { fee } = getDeliveryFeeAndLabel();
            const dFee = cart.length ? fee : 0;
            document.getElementById('c-subtotal').innerText = `${subtotal}৳`;
            document.getElementById('c-delivery').innerText = `${dFee}৳`;
            document.getElementById('c-total').innerText = `${subtotal + dFee}৳`;
        }

        function submitCustomerOrder(e) {
            e.preventDefault();
            if (!cart.length) {
                alert('দয়া করে আগে কার্টে অন্তত একটি পণ্য যোগ করুন।');
                return;
            }
            const name = document.getElementById('c-name').value.trim();
            const phone = document.getElementById('c-phone').value.trim();
            const address = document.getElementById('c-address').value.trim();
            const subtotal = cart.reduce((s, i) => s + (i.price * i.qty), 0);
            const { fee, label } = getDeliveryFeeAndLabel();
            const total = subtotal + fee;

            let msg = `🛒 *নতুন অর্ডার - ${cfg.shopName}*\n\n`;
            msg += `👤 নাম: ${name}\n📞 মোবাইল: ${phone}\n📍 ঠিকানা: ${address}\n🚚 এলাকা: ${label}\n\n*পণ্যের বিবরণ:*\n`;
            cart.forEach((item, idx) => {
                msg += `${idx + 1}. ${item.name} - ${item.price}৳ × ${item.qty} = ${item.price * item.qty}৳\n`;
            });
            msg += `\n📦 ডেলিভারি চার্জ: ${fee}৳\n💰 *সর্বমোট বিল: ${total}৳*\n💳 পেমেন্ট: ক্যাশ অন ডেলিভারি`;

            const cleanWa = String(cfg.whatsapp).replace(/\D/g, '') || '8801706555373';
            const waUrl = `https://wa.me/${cleanWa}?text=${encodeURIComponent(msg)}`;

            cart = [];
            updateCartBadge();
            closeCartDrawer();
            document.getElementById('c-name').value = '';
            document.getElementById('c-phone').value = '';
            document.getElementById('c-address').value = '';
            window.open(waUrl, '_blank');
        }

        applyConfig();
        renderProducts();
    </script>
</body>
</html>
