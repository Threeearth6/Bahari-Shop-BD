<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>বাহারী শপ বিডি</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;600;700&display=swap" rel="stylesheet">
    <style>body { font-family: 'Hind Siliguri', sans-serif; }</style>
</head>
<body class="bg-slate-50 text-slate-800">

    <!-- Header -->
    <header class="bg-emerald-900 text-white p-4 sticky top-0 z-40 shadow">
        <div class="max-w-6xl mx-auto flex justify-between items-center">
            <div>
                <h1 id="shop-title" class="text-xl font-bold">বাহারী শপ বিডি</h1>
                <p class="text-xs text-emerald-200">হটলাইন: <span id="top-phone">০১৭০৬৫৫৫৩৭৩</span></p>
            </div>
            <div class="flex gap-2">
                <button type="button" id="btn-admin" class="bg-amber-500 text-slate-900 font-bold px-4 py-2 rounded-lg text-sm">অ্যাডমিন</button>
                <button type="button" id="btn-cart" class="bg-white text-emerald-900 font-bold px-3 py-2 rounded-lg text-sm">কার্ট (<span id="cart-qty">0</span>)</button>
            </div>
        </div>
    </header>

    <!-- Notice -->
    <div class="bg-orange-600 text-white text-xs py-2 px-4 text-center font-semibold">
        <span id="notice-bar">সারাদেশে ক্যাশ অন ডেলিভারি! পণ্য হাতে পেয়ে মূল্য পরিশোধ করুন।</span>
    </div>

    <!-- Main -->
    <main class="max-w-6xl mx-auto p-4 space-y-6">
        <div id="product-list" class="grid grid-cols-2 md:grid-cols-4 gap-4"></div>
    </main>

    <!-- Admin Panel Section (Direct Toggle) -->
    <div id="admin-box" class="hidden fixed inset-0 bg-black/75 z-50 overflow-y-auto p-4">
        <div class="bg-white max-w-2xl mx-auto rounded-2xl p-5 space-y-4">
            <div class="flex justify-between items-center border-b pb-2">
                <h2 class="text-lg font-bold text-emerald-900">অ্যাডমিন কন্ট্রোল প্যানেল</h2>
                <button type="button" id="btn-close-admin" class="bg-red-100 text-red-600 px-3 py-1 rounded font-bold">বন্ধ করুন ✕</button>
            </div>

            <!-- Settings -->
            <div class="bg-emerald-50 p-3 rounded-xl space-y-2">
                <h3 class="font-bold text-sm">শপ সেটিংস</h3>
                <input type="text" id="in-shop" placeholder="দোকানের নাম" class="w-full p-2 border rounded text-sm">
                <input type="text" id="in-phone" placeholder="হটলাইন / হোয়াটসঅ্যাপ নম্বর" class="w-full p-2 border rounded text-sm">
                <input type="text" id="in-notice" placeholder="জরুরি নোটিশ" class="w-full p-2 border rounded text-sm">
                <button type="button" id="btn-save-cfg" class="w-full bg-emerald-800 text-white py-2 rounded font-bold text-sm">সেটিংস সেভ করুন</button>
            </div>

            <!-- Add Product -->
            <div class="bg-slate-100 p-3 rounded-xl space-y-2">
                <h3 class="font-bold text-sm">নতুন পণ্য যোগ করুন</h3>
                <input type="text" id="in-pname" placeholder="পণ্যের নাম" class="w-full p-2 border rounded text-sm">
                <input type="number" id="in-pprice" placeholder="দাম (টাকা)" class="w-full p-2 border rounded text-sm">
                <input type="file" id="in-pfile" accept="image/*" class="w-full text-xs bg-white p-2 border rounded">
                <textarea id="in-pdesc" rows="3" placeholder="পণ্যের বিস্তারিত বিবরণ লিখুন..." class="w-full p-2 border rounded text-sm"></textarea>
                <button type="button" id="btn-add-prod" class="w-full bg-orange-600 text-white py-2 rounded font-bold text-sm">পণ্য যোগ করুন</button>
            </div>

            <div id="admin-prods" class="space-y-2"></div>
        </div>
    </div>

    <!-- Cart Modal -->
    <div id="cart-box" class="hidden fixed inset-0 bg-black/75 z-50 overflow-y-auto p-4">
        <div class="bg-white max-w-md mx-auto rounded-2xl p-5 space-y-3">
            <div class="flex justify-between items-center border-b pb-2">
                <h2 class="font-bold text-emerald-900">আপনার কার্ট ও অর্ডার</h2>
                <button type="button" id="btn-close-cart" class="text-red-600 font-bold">✕</button>
            </div>
            <div id="cart-items" class="space-y-2 text-sm"></div>
            <p class="font-bold text-right text-orange-600">মোট: <span id="cart-total">0</span>৳</p>
            <input type="text" id="ord-name" placeholder="আপনার নাম" class="w-full p-2 border rounded text-sm">
            <input type="tel" id="ord-phone" placeholder="মোবাইল নম্বর" class="w-full p-2 border rounded text-sm">
            <textarea id="ord-addr" placeholder="সম্পূর্ণ ঠিকানা" class="w-full p-2 border rounded text-sm"></textarea>
            <button type="button" id="btn-order-wa" class="w-full bg-green-600 text-white py-2.5 rounded-lg font-bold text-sm">WhatsApp-এ অর্ডার পাঠান</button>
        </div>
    </div>

    <script>
        let cfg = JSON.parse(localStorage.getItem('b_cfg')) || {
            name: 'বাহারী শপ বিডি',
            phone: '01706555373',
            notice: 'সারাদেশে ক্যাশ অন ডেলিভারি! পণ্য হাতে পেয়ে মূল্য পরিশোধ করুন।'
        };
        let prods = JSON.parse(localStorage.getItem('b_prods')) || [
            { id: 1, name: 'প্রিমিয়াম কটন থ্রি-পিস', price: 1250, img: 'https://images.unsplash.com/photo-1610030469983-98e550d6193c?w=400', desc: '১০০% সুতি কাপড় ও আরামদায়ক ডিজাইন।' }
        ];
        let cart = [];
        let uploadedImg = '';

        function renderAll() {
            document.getElementById('shop-title').innerText = cfg.name;
            document.getElementById('top-phone').innerText = cfg.phone;
            document.getElementById('notice-bar').innerText = cfg.notice;

            document.getElementById('product-list').innerHTML = prods.map(p => `
                <div class="bg-white rounded-xl border p-3 shadow-sm flex flex-col justify-between">
                    <div>
                        <img src="${p.img}" class="w-full h-40 object-cover rounded-lg mb-2">
                        <h3 class="font-bold text-sm">${p.name}</h3>
                        <p class="text-orange-600 font-bold text-sm">${p.price}৳</p>
                        <p class="text-xs text-slate-500 mt-1">${p.desc || ''}</p>
                    </div>
                    <button type="button" onclick="addCart(${p.id})" class="mt-3 w-full bg-emerald-800 text-white py-1.5 rounded-lg text-xs font-bold">অর্ডার / কার্ট</button>
                </div>
            `).join('');

            document.getElementById('admin-prods').innerHTML = prods.map(p => `
                <div class="flex justify-between items-center border p-2 rounded text-xs">
                    <span>${p.name} (${p.price}৳)</span>
                    <button type="button" onclick="delProd(${p.id})" class="bg-red-500 text-white px-2 py-1 rounded">ডিলিট</button>
                </div>
            `).join('');
        }

        // Direct Admin Button Click with Prompt
        document.getElementById('btn-admin').addEventListener('click', function() {
            const pin = prompt('অ্যাডমিন পাসওয়ার্ড দিন (1234):');
            if (pin === '1234') {
                document.getElementById('in-shop').value = cfg.name;
                document.getElementById('in-phone').value = cfg.phone;
                document.getElementById('in-notice').value = cfg.notice;
                document.getElementById('admin-box').classList.remove('hidden');
            } else if (pin !== null) {
                alert('ভুল পাসওয়ার্ড!');
            }
        });

        document.getElementById('btn-close-admin').addEventListener('click', function() {
            document.getElementById('admin-box').classList.add('hidden');
        });

        document.getElementById('btn-save-cfg').addEventListener('click', function() {
            cfg.name = document.getElementById('in-shop').value || cfg.name;
            cfg.phone = document.getElementById('in-phone').value || cfg.phone;
            cfg.notice = document.getElementById('in-notice').value || cfg.notice;
            localStorage.setItem('b_cfg', JSON.stringify(cfg));
            renderAll();
            alert('সেটিংস সেভ হয়েছে!');
        });

        document.getElementById('in-pfile').addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = function(ev) { uploadedImg = ev.target.result; };
            reader.readAsDataURL(file);
        });

        document.getElementById('btn-add-prod').addEventListener('click', function() {
            const name = document.getElementById('in-pname').value;
            const price = Number(document.getElementById('in-pprice').value);
            const desc = document.getElementById('in-pdesc').value;
            if (!name || !price) { alert('নাম ও দাম দিন'); return; }
            prods.unshift({
                id: Date.now(),
                name,
                price,
                desc,
                img: uploadedImg || 'https://images.unsplash.com/photo-1523381210434-271e8be1f52b?w=400'
            });
            localStorage.setItem('b_prods', JSON.stringify(prods));
            uploadedImg = '';
            document.getElementById('in-pname').value = '';
            document.getElementById('in-pprice').value = '';
            document.getElementById('in-pdesc').value = '';
            renderAll();
            alert('পণ্য যুক্ত হয়েছে!');
        });

        function delProd(id) {
            prods = prods.filter(p => p.id !== id);
            localStorage.setItem('b_prods', JSON.stringify(prods));
            renderAll();
        }

        function addCart(id) {
            const p = prods.find(x => x.id === id);
            cart.push(p);
            document.getElementById('cart-qty').innerText = cart.length;
            alert('কার্টে যোগ হয়েছে!');
        }

        document.getElementById('btn-cart').addEventListener('click', function() {
            document.getElementById('cart-items').innerHTML = cart.map(c => `<div>• ${c.name} - ${c.price}৳</div>`).join('') || 'কার্ট খালি';
            document.getElementById('cart-total').innerText = cart.reduce((s, c) => s + c.price, 0);
            document.getElementById('cart-box').classList.remove('hidden');
        });

        document.getElementById('btn-close-cart').addEventListener('click', function() {
            document.getElementById('cart-box').classList.add('hidden');
        });

        document.getElementById('btn-order-wa').addEventListener('click', function() {
            const n = document.getElementById('ord-name').value;
            const ph = document.getElementById('ord-phone').value;
            const ad = document.getElementById('ord-addr').value;
            if (!cart.length || !n || !ph) { alert('কার্টে পণ্য এবং নাম-নম্বর দিন'); return; }
            const items = cart.map(c => `${c.name} (${c.price}৳)`).join(', ');
            const total = cart.reduce((s, c) => s + c.price, 0);
            const msg = `নতুন অর্ডার:\nনাম: ${n}\nফোন: ${ph}\nঠিকানা: ${ad}\nপণ্য: ${items}\nমোট: ${total}৳`;
            const wa = '88' + cfg.phone.replace(/\D/g, '').slice(-11);
            window.open(`https://wa.me/${wa}?text=${encodeURIComponent(msg)}`, '_blank');
        });

        renderAll();
    </script>
</body>
</html>
